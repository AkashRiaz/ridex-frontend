# ============================================
# Backend
# ============================================

# Base URL of ridex-backend including the API prefix (server-side only)
BACKEND_API_URL=http://localhost:5000/api/v1

# ============================================
# Auth — MUST match ridex-backend/.env
# Used by proxy.ts and service/refreshToken.ts to verify tokens locally.
# Server-side only: never prefix these with NEXT_PUBLIC_.
# ============================================

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Public (exposed to the browser)
# ============================================

# Brand name shown in the UI (see lib/siteConfig.ts)
NEXT_PUBLIC_APP_NAME=RideX
# Canonical site URL, used for metadata / Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backend origin for Socket.io (chat, live notifications). No /api/v1 suffix.
# The browser connects here directly, so the backend CORS_ORIGINS must include this frontend's URL.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# ISO 4217 currency code and Intl locale for price formatting
NEXT_PUBLIC_CURRENCY=BDT
NEXT_PUBLIC_DEFAULT_LOCALE=en-BD
